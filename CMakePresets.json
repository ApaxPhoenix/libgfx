{
  "version": 6,
  "configurePresets": [
    {
      "name": "macos",
      "hidden": true,
      "description": "Homebrew LLVM, vcpkg's arm64-osx Skia, and the slangc next to libsci.",
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
        "CMAKE_PREFIX_PATH": "$env{HOME}/vcpkg/installed/arm64-osx",
        "SLANGC": "${sourceDir}/../libsci/vendors/slang/bin/slangc",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_MAP_IMPORTED_CONFIG_DEBUG": "Release;"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "macos",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "macos",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "tidy",
      "displayName": "Debug + clang-tidy",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/cmake-build-tidy",
      "cacheVariables": {
        "GFX_CLANG_TIDY": "ON",
        "CLANG_TIDY": "/opt/homebrew/opt/llvm/bin/clang-tidy"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "tidy", "configurePreset": "tidy" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
