# Text is stored with LF and checked out with LF everywhere, so Git for Windows'
# CRLF default leaves no stray diffs and the shell snippets still run.
* text=auto eol=lf

*.cpp text diff=cpp
*.hpp text diff=cpp
*.slang text diff=cpp
*.cmake text
CMakeLists.txt text
*.json text
*.md text diff=markdown

*.png binary
*.spv binary

# Slang is C-like; GitHub has no grammar of its own for it, so count it as HLSL,
# which it extends.
*.slang linguist-language=HLSL

# CLion's project files are editor settings, not code.
.idea/** linguist-generated
